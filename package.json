{
  "name": "monapay-sapo",
  "version": "0.1.0",
  "description": "Connector xac nhan chuyen khoan ngan hang tu dong giua Sapo Web va MONA Pay",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npm run build && node --watch dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "setup:webhook": "npm run build && node dist/scripts/register-sapo-webhook.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
